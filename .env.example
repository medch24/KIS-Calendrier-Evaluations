# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kis-calendrier?retryWrites=true&w=majority

# Server Configuration
PORT=3000

# Instructions:
# 1. Créer un compte MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# 2. Créer un cluster gratuit
# 3. Créer un utilisateur database
# 4. Whitelist IP: 0.0.0.0/0
# 5. Copier la connection string et remplacer username, password, cluster
# 6. Renommer ce fichier en .env pour le développement local
# 7. Pour Vercel: Ajouter MONGODB_URI dans Settings → Environment Variables
